# SPDX-License-Identifier: GPL-3.0-only
# SiDJ (https://github.com/thomasj/fm1-sidj, tag v1.5.1 = c9544f2; GPL-3.0-only, its SID engine GPL-2.0-or-later), a
# C64 music deck (a cycle-exact 6510 and reSID-derived SID chips playing .sid files, remixed live) on X0X's platform
# (Felucca's): the plat glue (core-glue/plat/README.md) over the unmodified submodule. The device's unity build
# (firmware/src/sidj.c: the UI, the settings, the song store and its SysEx transfer, the kept MIDI clocks) is
# core_sidj.c; the SID, the C64 and the engine its own units, as tools/build.py builds them (O2_UNITS: sidj_*.c,
# -O2). Generated, by tools/build.py generate(): the screen font (tools/gen_font.py: Barlow Semi Condensed and
# Terminus, Pillow with libraqm). The songs are the player's .sid files, added over SysEx from the songs page
# (web/site, #songs) as on the device; the author's two tunes the site and the browser emulator come with
# (web/site/songs/, songs.json) are compiled in, unmodified, and put in an empty song store at boot (below).
set(_sidj ${CMAKE_SOURCE_DIR}/cores/fm1-sidj)
fm1_add_core(sidj ${CMAKE_CURRENT_LIST_DIR} SOURCE ${_sidj} UNIT core_sidj.c DESC core_sidj_desc.c
             EXTRA_SOURCES sidj_sid.c sidj_sid_tables.c sidj_engine.c sidj_remix.c sidj_asid.c sidj_cpu6502.c
                           sidj_c64.c sidj_sidfile.c
             FAMILY plat LICENSE GPL-3.0-only
             CREDITS "SiDJ by Thomas Jansson (tubesockor), on Felucca's platform (Leo Kuroshita, Hügelton Instruments) by way of X0X (Charles Vestal).\nThe tunes it comes with: Debut & Credit (2024) and TwinCross (2026) by Thomas Jansson (tubesockor), as released in HVSC and on CSDb, unmodified. They are music, not part of the firmware, and not under the GPL: free to play and to share unmodified with SiDJ. For anything else, ask the author.\nThe SID engine: a C port of reSID 0.16 by Dag Lem, GPL-2.0-or-later.\nThe fonts: Barlow Semi Condensed by Jeremy Tribby and Terminus by Dimitar Zhekov, SIL OFL 1.1."
             GEN felucca_font.h PYTHON_NEEDS raqm
             VERSION 1.5.1
             FLAGS -ffp-contract=off
             INCLUDES ${_sidj} ${_sidj}/firmware/src/app ${_sidj}/firmware/src/c64 ${_sidj}/sid)

# the bundled tunes (LICENSING.md "The tunes that come with the site"): web/site/songs/songs.json's files, as the
# browser emulator preloads them (web/emu/index.html: the bytes, the song lengths, the MD5), into a header in the
# build tree, <build>/core_sidj_tunes/sidj_tunes.h (written at configure time, only when it changed); core_sidj.c
# puts them in a song store never written (fm1core_pl_app_boot). Their terms: a licence section of the .rfm1
# (sidj_tunes_terms.txt, that section of LICENSING.md as it is)
set(_tdir ${CMAKE_BINARY_DIR}/core_sidj_tunes)
set(_songs ${_sidj}/web/site/songs)
file(READ ${_songs}/songs.json _json)
string(JSON _nt LENGTH "${_json}")
math(EXPR _last "${_nt} - 1")
set(_h "/* generated by core_sidj.cmake from ${_songs}/songs.json: the tunes, unmodified */\n")
set(_tab "")
set(_deps ${_songs}/songs.json ${_sidj}/LICENSING.md)
foreach(_i RANGE ${_last})
    string(JSON _f GET "${_json}" ${_i} file)
    string(JSON _nl LENGTH "${_json}" ${_i} lens)
    set(_lens "")
    if(_nl GREATER 0)
        math(EXPR _ll "${_nl} - 1")
        foreach(_j RANGE ${_ll})
            string(JSON _l GET "${_json}" ${_i} lens ${_j})
            string(APPEND _lens "${_l}u, ")
        endforeach()
    else()
        set(_lens "0")
    endif()
    file(READ ${_songs}/${_f} _hex HEX)
    file(SIZE ${_songs}/${_f} _sz)
    file(MD5 ${_songs}/${_f} _md5)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _md5b "${_md5}")
    string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n    "
                         _bytes "${_bytes}")   # (16 a line)
    string(APPEND _h "/* ${_f} */\nstatic const uint8_t sidj_tune_${_i}[${_sz}] = {\n    ${_bytes}\n};\n"
                     "static const uint16_t sidj_tune_${_i}_lens[] = {${_lens}};\n")
    string(APPEND _tab "    {sidj_tune_${_i}, ${_sz}u, {${_md5b}}, sidj_tune_${_i}_lens, ${_nl}},\n")
    list(APPEND _deps ${_songs}/${_f})
endforeach()
string(APPEND _h "static const struct { const uint8_t *data; uint32_t size; uint8_t md5[16]; const uint16_t *lens; int nlen; }\n"
                 "    sidj_tunes[${_nt}] = {\n${_tab}};\n#define SIDJ_NTUNES ${_nt}\n")
set(_old "")
if(EXISTS ${_tdir}/sidj_tunes.h)
    file(READ ${_tdir}/sidj_tunes.h _old)
endif()
if(NOT _old STREQUAL _h)
    file(WRITE ${_tdir}/sidj_tunes.h "${_h}")
endif()
file(READ ${_sidj}/LICENSING.md _lic)
string(FIND "${_lic}" "## The tunes that come with the site" _a)
if(_a LESS 0)
    message(FATAL_ERROR "sidj: LICENSING.md has no \"The tunes that come with the site\" section")
endif()
string(SUBSTRING "${_lic}" ${_a} -1 _lic)
string(FIND "${_lic}" "\n## " _b)
string(SUBSTRING "${_lic}" 0 ${_b} _lic)
string(STRIP "${_lic}" _lic)
set(_old "")
if(EXISTS ${_tdir}/sidj_tunes_terms.txt)
    file(READ ${_tdir}/sidj_tunes_terms.txt _old)
endif()
if(NOT _old STREQUAL "${_lic}\n")
    file(WRITE ${_tdir}/sidj_tunes_terms.txt "${_lic}\n")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_deps})
target_include_directories(core_sidj_obj PRIVATE ${_tdir})
set_property(SOURCE ${CMAKE_CURRENT_LIST_DIR}/core_sidj.c APPEND PROPERTY OBJECT_DEPENDS ${_tdir}/sidj_tunes.h)

# the .rfm1 (cmake/FM1Rfm1.cmake: -DFM1_RFM1=ON; docs/RFM1.md). A fresh flash has the two tunes (above), the first
# selected, as at the browser emulator's first visit, where PLAY starts it; RUN_ARGS: PLAY tapped before the chord
# (ui.c ui_play_btn: it loads and plays Debut & Credit), the chord then plays voice 1 over it
fm1_add_rfm1(sidj AUTHORS "Thomas Jansson (tubesockor)"
             LICENSE_FILES "GPL-3.0-only ({name})=LICENSE"
                           "GPL-2.0-or-later (the SID engine in {name}, after reSID 0.16)=third_party/licenses/GPL-2.0.txt"
                           "OFL-1.1 (the Barlow Semi Condensed font in {name})=assets/fonts/Barlow-OFL.txt"
                           "OFL-1.1 (the Terminus font in {name})=assets/fonts/Terminus-LICENSE.txt"
                           "Not GPL: the tunes in {name}, Debut & Credit and TwinCross by Thomas Jansson (tubesockor)=${_tdir}/sidj_tunes_terms.txt"
             RUN_ARGS --tap 10)   # PLAY
