 crates/fm1-core/src/jit_wasm.rs | 117 ++++++++++++++++++++++----------
 crates/fm1-core/src/lib.rs      |  42 ++++++++++--
 2 files changed, 121 insertions(+), 38 deletions(-)

diff --git a/crates/fm1-core/src/jit_wasm.rs b/crates/fm1-core/src/jit_wasm.rs
index f78db1f..5c2bc1b 100644
--- a/crates/fm1-core/src/jit_wasm.rs
+++ b/crates/fm1-core/src/jit_wasm.rs
@@ -329,6 +329,15 @@ const I64_SHR_U: u8 = 0x88;
 const I64_CONST: u8 = 0x42;
 const I64_EQZ: u8 = 0x50;
 const F32_REINTERPRET_I32: u8 = 0xbe;
+const I32_REINTERPRET_F32: u8 = 0xbc;
+const F32_ADD: u8 = 0x92;
+const F32_SUB: u8 = 0x93;
+const F32_MUL: u8 = 0x94;
+const F32_DIV: u8 = 0x95;
+const F32_CONVERT_I32_S: u8 = 0xb2;
+const F32_CONVERT_I32_U: u8 = 0xb3;
+/// the 0xfc prefix: i32.trunc_sat_f32_s (0), _u (1), what Rust's `f32 as i32 / u32` compile to
+const MISC: u8 = 0xfc;
 const I32_EXTEND8_S: u8 = 0xc0;
 const I32_EXTEND16_S: u8 = 0xc1;
 const VOID: u8 = 0x40;
@@ -605,6 +614,28 @@ impl Gen<'_> {
         }
         self.set(L_B);
     }
+    /// push whether an `if (..) {` block's condition holds for locals a and b (`exec_fast`'s
+    /// IfBlk: family 2 the bit test, else `cmp_cond`, whose float families compare as floats)
+    fn if_taken(&mut self, fam: u8, alt: bool) {
+        if fam == 2 {
+            self.get(L_A);
+            self.get(L_B);
+            self.op(I32_AND);
+            self.i32c(0);
+            self.op(I32_NE);
+            self.i32c(alt as u32);
+            self.op(I32_EQ);
+        } else if fam >= 8 {
+            self.cmp(crate::cond_of_fam(fam as u64, alt));
+        } else {
+            self.get(L_A);
+            self.get(L_B);
+            self.op(match fam { 0 => I32_EQ, 1 => I32_GE_U, 4 => I32_GT_U, 5 => I32_GE_S, _ => I32_GT_S });
+            if alt {
+                self.op(I32_EQZ);
+            }
+        }
+    }
     /// push the compare of locals a and b
     fn cmp(&mut self, c: Cond) {
         let float = c.is_float();
@@ -1259,7 +1290,7 @@ fn block<B: Bus>(g: &mut Gen<'_>, pc0: u32, ops: &[crate::BOp]) {
                 g.goto(target, count, false);
                 g.end();
             }
-            Fast::IfBlk { a, rk, fam, alt, has_else: true, rv, then_d, else_d } if fam < 8 && g.pred.is_none() => {
+            Fast::IfBlk { a, rk, fam, alt, has_else: true, rv, then_d, else_d } if g.pred.is_none() => {
                 // the region brought its then-part along (`Cpu::wasm_region`): the rest of this
                 // block's ops. Not taken: on at the else part. Taken: the then-part, then past
                 // the else part (the interpreter's pred_skips, kept by check_brk on an exit)
@@ -1268,22 +1299,7 @@ fn block<B: Bus>(g: &mut Gen<'_>, pc0: u32, ops: &[crate::BOp]) {
                 g.rhs(rk, rv);
                 g.ld_reg(a);
                 g.set(L_A);
-                if fam == 2 {
-                    g.get(L_A);
-                    g.get(L_B);
-                    g.op(I32_AND);
-                    g.i32c(0);
-                    g.op(I32_NE);
-                    g.i32c(alt as u32);
-                    g.op(I32_EQ);
-                } else {
-                    g.get(L_A);
-                    g.get(L_B);
-                    g.op(match fam { 0 => I32_EQ, 1 => I32_GE_U, 4 => I32_GT_U, 5 => I32_GE_S, _ => I32_GT_S });
-                    if alt {
-                        g.op(I32_EQZ);
-                    }
-                }
+                g.if_taken(fam, alt);
                 g.op(I32_EQZ);
                 g.if_();
                 g.goto(then_end, count, false);
@@ -1298,27 +1314,12 @@ fn block<B: Bus>(g: &mut Gen<'_>, pc0: u32, ops: &[crate::BOp]) {
                 pc = next_pc;
                 continue;
             }
-            Fast::IfBlk { a, rk, fam, alt, has_else: false, rv, then_d, .. } if fam < 8 => {
+            Fast::IfBlk { a, rk, fam, alt, has_else: false, rv, then_d, .. } => {
                 // taken: the then-part follows; not taken: skip it
                 g.rhs(rk, rv);
                 g.ld_reg(a);
                 g.set(L_A);
-                if fam == 2 {
-                    g.get(L_A);
-                    g.get(L_B);
-                    g.op(I32_AND);
-                    g.i32c(0);
-                    g.op(I32_NE);
-                    g.i32c(alt as u32);
-                    g.op(I32_EQ);
-                } else {
-                    g.get(L_A);
-                    g.get(L_B);
-                    g.op(match fam { 0 => I32_EQ, 1 => I32_GE_U, 4 => I32_GT_U, 5 => I32_GE_S, _ => I32_GT_S });
-                    if alt {
-                        g.op(I32_EQZ);
-                    }
-                }
+                g.if_taken(fam, alt);
                 g.op(I32_EQZ);
                 g.if_();
                 g.goto(next_pc.wrapping_add(then_d as u32), count, false);
@@ -1356,6 +1357,54 @@ fn block<B: Bus>(g: &mut Gen<'_>, pc0: u32, ops: &[crate::BOp]) {
                 g.jump_local(L_VAL, count);
                 ended = true;
             }
+            Fast::CallR { r } | Fast::GotoR { r } => {
+                g.ld_reg(r);
+                g.set(L_VAL);
+                if matches!(op.fast, Fast::CallR { .. }) {
+                    g.get(L_CPU);
+                    g.i32c(next_pc);
+                    g.mem_op(I32_STORE, 2, off_rets());
+                }
+                g.jump_local(L_VAL, count);
+                ended = true;
+            }
+            // the FPU (`fpu_d`): the same wasm float ops its Rust compiles to, so the same bits;
+            // fmin / fmax (Rust's NaN rules) and unknown unary codes stay with the helper
+            Fast::FOp { d, a, b, op } if matches!(op, 0..=3 | 7 | 8 | 0x1f | 0x5f | 0x8f | 0x9f) => {
+                g.get(L_CPU);
+                let f = |g: &mut Gen<'_>, r: u8| {
+                    g.ld_reg(r);
+                    g.op(F32_REINTERPRET_I32);
+                };
+                match op {
+                    0..=3 => {
+                        f(g, a);
+                        f(g, b);
+                        g.op([F32_ADD, F32_SUB, F32_MUL, F32_DIV][op as usize]);
+                        g.op(I32_REINTERPRET_F32);
+                    }
+                    7 | 8 => {
+                        // acc +- a * b, the product rounded first (not fused)
+                        f(g, d);
+                        f(g, a);
+                        f(g, b);
+                        g.op(F32_MUL);
+                        g.op(if op == 7 { F32_ADD } else { F32_SUB });
+                        g.op(I32_REINTERPRET_F32);
+                    }
+                    0x1f | 0x5f => {
+                        f(g, a);
+                        g.op(MISC);
+                        uleb(&mut g.c, if op == 0x1f { 0 } else { 1 });
+                    }
+                    _ => {
+                        g.ld_reg(a);
+                        g.op(if op == 0x8f { F32_CONVERT_I32_S } else { F32_CONVERT_I32_U });
+                        g.op(I32_REINTERPRET_F32);
+                    }
+                }
+                g.mem_op(I32_STORE, 2, off_reg(d));
+            }
             // ---- everything else: the interpreter's executor for this one op
             other => {
                 let p: &'static Fast = Box::leak(Box::new(other));
diff --git a/crates/fm1-core/src/lib.rs b/crates/fm1-core/src/lib.rs
