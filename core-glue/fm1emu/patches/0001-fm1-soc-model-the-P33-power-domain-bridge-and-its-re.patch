diff --git a/crates/fm1-soc/src/p33.rs b/crates/fm1-soc/src/p33.rs
new file mode 100644
index 0000000..6bb3493
--- /dev/null
+++ b/crates/fm1-soc/src/p33.rs
@@ -0,0 +1,171 @@
+//! P33: the power-management domain's register file, reached through a byte-serial bridge
+//! (JL_P33 at 0x13E00, SDK WL82.h: PMU_CON +0, RTC_CON +4, SPI_CON +8, SPI_DAT +C).
+//!
+//! The bridge (SDK p33.h `p33_cs_h` / `p33_cs_l`; the FM-1 firmwares' `fm1__p33_xfer`):
+//! - SPI_CON bit 0 selects the domain (a frame starts), bit 8 with it picks the RTC bank
+//!   (addresses with bit 15 set, `RTC_SFR_BEGIN`); clearing bit 0 ends the frame.
+//! - A byte goes out when SPI_CON is written with bit 4 set (the "kick"); bit 1 reads busy.
+//!   Here a byte moves at once: bit 1 and bit 4 always read 0.
+//! - SPI_DAT holds the byte to send and, after a transfer, the byte received.
+//! - A frame is three bytes: `op << 5 | addr[9:8]` with bit 7 for a read (op: 0 write, 1 or,
+//!   2 and, 3 xor), then `addr[7:0]`, then the data (a dummy for a read, whose value then
+//!   reads back in SPI_DAT).
+//!
+//! The registers are plain storage (reset value 0), with two exceptions where reading the
+//! stored byte back would be wrong: P3_WDT_CON's bit 6 is the watchdog-clear strobe the feed
+//! writes, and P3_PR_PWR bit 4 is the soft-reset request (neither is modelled further).
+//! Firmwares that read back what they wrote (Melodee 1.4: its supply setup and watchdog arm
+//! verify every field, and a failed check keeps CPU1 off or halts) need the storage; before
+//! this the block was unknown MMIO and every read returned 0.
+
+const P3_WDT_CON: usize = 0x80;
+const P3_PR_PWR: usize = 0xa0;
+
+pub struct P33 {
+    con: u32,
+    dat: u32,
+    pmu_con: u32,
+    rtc_con: u32,
+    /// bytes received in this frame (0..3)
+    pos: u8,
+    head: u8,
+    addr: u16,
+    /// the P33 bank (0x000..0x3FF) and the RTC bank (bit 15 addresses)
+    regs: Box<[[u8; 1024]; 2]>,
+    /// FM1_P33_TRACE: print each frame
+    trace: bool,
+}
+
+impl Default for P33 {
+    fn default() -> Self {
+        P33 {
+            con: 0,
+            dat: 0,
+            pmu_con: 0,
+            rtc_con: 0,
+            pos: 0,
+            head: 0,
+            addr: 0,
+            regs: Box::new([[0; 1024]; 2]),
+            trace: std::env::var_os("FM1_P33_TRACE").is_some(),
+        }
+    }
+}
+
+impl P33 {
+    pub fn read(&self, addr: u32) -> u32 {
+        match addr & 0xf {
+            0x0 => self.pmu_con,
+            0x4 => self.rtc_con,
+            0x8 => self.con & !0x12,
+            0xc => self.dat,
+            _ => 0,
+        }
+    }
+
+    pub fn write(&mut self, addr: u32, value: u32) {
+        match addr & 0xf {
+            0x0 => self.pmu_con = value,
+            0x4 => self.rtc_con = value,
+            0x8 => {
+                if value & 1 == 0 || self.con & 1 == 0 {
+                    // chip select released (or just taken): a new frame
+                    self.pos = 0;
+                }
+                self.con = value & !0x12;
+                if value & 0x10 != 0 && value & 1 != 0 {
+                    self.transfer();
+                }
+            }
+            0xc => self.dat = value & 0xff,
+            _ => {}
+        }
+    }
+
+    /// The register `addr` of the bank picked by SPI_CON bit 8 (a debugger's view).
+    pub fn reg(&self, rtc: bool, addr: u16) -> u8 {
+        self.regs[rtc as usize][(addr & 0x3ff) as usize]
+    }
+
+    fn transfer(&mut self) {
+        let b = (self.dat & 0xff) as u8;
+        match self.pos {
+            0 => {
+                self.head = b;
+                self.addr = ((b as u16) & 3) << 8;
+                self.pos = 1;
+            }
+            1 => {
+                self.addr |= b as u16;
+                self.pos = 2;
+            }
+            2 => {
+                let bank = ((self.con >> 8) & 1) as usize;
+                let a = self.addr as usize;
+                let r = &mut self.regs[bank][a];
+                if self.head & 0x80 != 0 {
+                    self.dat = *r as u32;
+                } else {
+                    let v = match (self.head >> 5) & 3 {
+                        0 => b,
+                        1 => *r | b,
+                        2 => *r & b,
+                        _ => *r ^ b,
+                    };
+                    // strobes: the watchdog clear, the soft-reset request
+                    *r = match (bank, a) {
+                        (0, P3_WDT_CON) => v & !0x40,
+                        (0, P3_PR_PWR) => v & !0x10,
+                        _ => v,
+                    };
+                }
+                if self.trace {
+                    let op = if self.head & 0x80 != 0 { "rd" } else { ["wr", "or", "and", "xor"][((self.head >> 5) & 3) as usize] };
+                    println!("p33 {}{op} {:#05x} {b:#04x} -> {:#04x}", if bank == 1 { "rtc " } else { "" }, a, self.regs[bank][a]);
+                }
+                self.pos = 3;
+            }
+            _ => {}
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::P33;
+
+    // one frame as the FM-1 firmwares send it (Melodee hal/fm1_sys.h fm1__p33_op / fm1_p33_read)
+    fn frame(p: &mut P33, rtc: bool, bytes: [u8; 3]) -> u8 {
+        let sel = if rtc { 0x101 } else { 0x001 };
+        p.write(0x13e08, 0);
+        p.write(0x13e08, sel);
+        for b in bytes {
+            p.write(0x13e0c, b as u32);
+            let con = p.read(0x13e08);
+            p.write(0x13e08, con | 0x10);
+            assert_eq!(p.read(0x13e08) & 2, 0, "never busy");
+        }
+        let v = p.read(0x13e0c) as u8;
+        p.write(0x13e08, p.read(0x13e08) & !0x101);
+        v
+    }
+
+    #[test]
+    fn write_modify_read() {
+        let mut p = P33::default();
+        assert_eq!(frame(&mut p, false, [0x80, 0x09, 0x5e]), 0, "reset value");
+        frame(&mut p, false, [0x00, 0x09, 0x10]); // write
+        frame(&mut p, false, [0x20, 0x09, 0x0f]); // or
+        assert_eq!(frame(&mut p, false, [0x80, 0x09, 0x5e]), 0x1f);
+        frame(&mut p, false, [0x40, 0x09, 0xf3]); // and
+        frame(&mut p, false, [0x60, 0x09, 0x01]); // xor
+        assert_eq!(frame(&mut p, false, [0x80, 0x09, 0x5e]), 0x12);
+        // address bits 9:8 in the first byte; the RTC bank is separate
+        frame(&mut p, false, [0x01, 0x09, 0xaa]);
+        assert_eq!(p.reg(false, 0x109), 0xaa);
+        assert_eq!(frame(&mut p, true, [0x80, 0x09, 0x5e]), 0);
+        // the watchdog clear strobe does not read back
+        frame(&mut p, false, [0x00, 0x80, 0x5d]);
+        assert_eq!(frame(&mut p, false, [0x80, 0x80, 0x5e]), 0x1d);
+    }
+}
