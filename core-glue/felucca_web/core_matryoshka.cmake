# SPDX-License-Identifier: GPL-3.0-only
# Matryoshka 1.9.1 (https://github.com/glvno/matryoshka, tag v1.9.1 = 4c4b12f; GPL-3.0-only): michael glaviano's
# Nord Modular-style patchable synth, a hard fork of morgulbrut's Modular-1, on Felucca's hardware layer (its own copy of
# Felucca's header-only HAL at a4d7ca2e, firmware/hal). Not Felucca's web/emu (Matryoshka has none, nor Felucca's
# engines): the device's own single unit, firmware/src/modular.c, unmodified, with every firmware/hal header read as
# core-glue/felucca_web/matryoshka_hal.h (clang's -ivfsoverlay, written below into the build folder), and the main loop
# (main.c fm1_main) on a coroutine (core_matryoshka.c). The headers modular.c includes (defs.h, presets.h, the DSP and
# wavetable tables, font_bc.h, splash_art.h) are generated by the web app's scripts and committed: NO_GEN.
# The build as tools/build.py --release 1.9.1 stamps it: FELUCCA_ID "FM-1_7010901" (release_identity: FM-1_7 + two
# digits each), FELUCCA_VERSION "v1.9.1", M1_FW_MAJOR / MINOR / PATCH 1 8 2 (INFO's firmware version, proto.c). The
# firmware's emulator build's MIDI (M1_EMU_MIDI=1: usb.c's RAM mailbox instead of EP1, docs/EMULATOR.md) is the core's
# USB; FELUCCA_UAC=0 (no USB audio function: the host takes the audio from audio()).
# -O2 (after the .rfm1 build's -O3, which wins otherwise): at -O3 clang's IndVarSimplify / ScalarEvolution never ends on the
# one big unit (sampled: isImpliedCond recursing, 15+ minutes), at -O2 it compiles in seconds (the native default).
# Gating: clean. LICENSING.md: GPL-3.0-only (Matryoshka, Modular-1, Felucca's copied files); the LCD's Barlow Condensed
# bitmaps (font_bc.h) OFL-1.1; the rate envelope's clock after ymfm (rate_envelope.h) BSD-3-Clause; the factory patches
# Matryoshka's own (gen-presets.ts; no samples, D-303). The JieLi SDK files (Apache-2.0) are in device packages only, M-VAVE's
# V15 and the web app's fonts, logos and community patches are not in the firmware.
set(_mt ${CMAKE_SOURCE_DIR}/cores/matryoshka)
set(_mt_ver 1.9.1)
set(_mt_vfs ${CMAKE_BINARY_DIR}/core_vfs/matryoshka.yaml)
set(_mt_roots "")
foreach(_h fm1_adc fm1_audio fm1_cc fm1_flash fm1_gpio fm1_guard fm1_input fm1_irq fm1_lcd_hw fm1_led_anim fm1_sys
           fm1_time fm1_timer fm1_uart fm1_usb fm1_xip)
    if(_mt_roots)
        string(APPEND _mt_roots ", ")
    endif()
    string(APPEND _mt_roots "{ \"type\": \"file\", \"name\": \"${_mt}/firmware/hal/${_h}.h\", \"external-contents\": \"${CMAKE_CURRENT_LIST_DIR}/matryoshka_hal.h\" }")
endforeach()
file(WRITE ${_mt_vfs}.in "{ \"version\": 0, \"case-sensitive\": \"false\", \"roots\": [ ${_mt_roots} ] }\n")
configure_file(${_mt_vfs}.in ${_mt_vfs} COPYONLY)
fm1_add_core(matryoshka ${CMAKE_CURRENT_LIST_DIR} SOURCE ${_mt} UNIT core_matryoshka.c DESC core_matryoshka_desc.c
             FAMILY felucca_web LICENSE GPL-3.0-only
             CREDITS "Matryoshka by michael glaviano (glvno), derived from Modular-1 by morgulbrut (WiggisModular), GPL-3.0-only. Its hardware layer, update loader and USB and update path are copied from Felucca by Leo Kuroshita (Hügelton Instruments), GPL-3.0-only. The rate envelope's clock is adapted from ymfm by Aaron Giles (BSD-3-Clause). The screen's type is Barlow Condensed SemiBold (The Barlow Project Authors), SIL Open Font License 1.1."
             CREDITS_FILES LICENSES/BSD-3-Clause-ymfm.txt
             NO_GEN VERSION ${_mt_ver}
             INCLUDES ${_mt}/firmware/hal
             DEFINES FELUCCA_ID="FM-1_7010901" FELUCCA_VERSION="v${_mt_ver}" M1_FW_MAJOR=1 M1_FW_MINOR=8 M1_FW_PATCH=2
                     M1_EMU_MIDI=1 FELUCCA_UAC=0
             FLAGS "-Dsection(x)=aligned(4)" "-ivfsoverlay${_mt_vfs}" -O2)
if(TARGET core_matryoshka_obj)
    # (the overlaid headers are not in the compiler's dependency list under their real names)
    set_property(SOURCE ${CMAKE_CURRENT_LIST_DIR}/core_matryoshka.c APPEND PROPERTY OBJECT_DEPENDS
                 ${CMAKE_CURRENT_LIST_DIR}/matryoshka_hal.h ${_mt_vfs})
endif()
# the .rfm1 (cmake/FM1Rfm1.cmake: -DFM1_RFM1=ON; docs/RFM1.md). The licence texts: what is compiled in (LICENSING.md
# "What a release ships", less the JieLi SDK's Apache-2.0, which only a device package embeds): the GPL, LICENSING.md,
# Barlow Condensed's OFL (the LCD's bitmaps) and ymfm's notice. Not the other LICENSES/ texts (Felucca's own material,
# none of it in Matryoshka's firmware: LICENSING.md says releases do not ship them) nor the web app's fonts.
fm1_add_rfm1(matryoshka AUTHORS "michael glaviano (glvno)" "morgulbrut"
             LICENSE_FILES "GPL-3.0-only ({name})=LICENSE"
                           "LICENSING.md ({name})=LICENSING.md"
                           "OFL-1.1 (Barlow Condensed, the screen's type in {name})=web/public/fonts/OFL-BarlowCondensed.txt"
                           "BSD-3-Clause (ymfm's envelope clock in {name})=LICENSES/BSD-3-Clause-ymfm.txt")
